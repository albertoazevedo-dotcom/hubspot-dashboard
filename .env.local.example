# HubSpot OAuth credentials
# Create a private app at: https://developers.hubspot.com → Apps → Create app
HUBSPOT_CLIENT_ID=your_client_id_here
HUBSPOT_CLIENT_SECRET=your_client_secret_here

# Must match the redirect URI configured in your HubSpot app
HUBSPOT_REDIRECT_URI=http://localhost:3000/oauth/callback

# Used by server components to self-fetch API routes
# In production: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
