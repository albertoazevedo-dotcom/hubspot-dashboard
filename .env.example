# ── HubSpot OAuth ─────────────────────────────────────────────────────────────
# Crie um app em: https://developers.hubspot.com/get-started
# Em "Auth" > "OAuth" copie Client ID e Client Secret abaixo.
HUBSPOT_CLIENT_ID=your_client_id_here
HUBSPOT_CLIENT_SECRET=your_client_secret_here

# URL de callback configurada no app HubSpot (deve ser exatamente igual)
# Em desenvolvimento: http://localhost:3000/oauth/callback
# Em produção: https://seudominio.com/oauth/callback
REDIRECT_URI=http://localhost:3000/oauth/callback

# ── App ───────────────────────────────────────────────────────────────────────
# Necessário para que as rotas server-side consigam chamar a própria API
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Segredo para assinatura dos cookies de sessão (qualquer string longa aleatória)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa-e-segura

# ── Configuração de Scopes HubSpot ────────────────────────────────────────────
# Os seguintes scopes precisam estar habilitados no app HubSpot:
#   crm.objects.deals.read
#   crm.schemas.deals.read
#   crm.objects.contacts.read
